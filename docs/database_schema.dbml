Project banking_fraud_detection {
  database_type: 'PostgreSQL'
  Note: 'Target PostgreSQL schema. Flyway V2 creates the fraud and graph views; V3 creates auth_refresh_tokens. Legacy schema_metadata from V1 is omitted from this business model.'
}

Table users {
  id uuid [pk, note: 'Database default: gen_random_uuid()']
  username varchar(50) [not null, unique]
  password_hash varchar(100) [not null, note: 'BCrypt hash; plaintext passwords are never stored']
  full_name varchar(120) [not null]
  email varchar(254) [not null, unique]
  role varchar(20) [not null, default: 'BANK_USER', note: 'Allowed values: ADMIN, BANK_USER']
  status varchar(20) [not null, default: 'ACTIVE', note: 'Allowed values: ACTIVE, DISABLED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Bank employees who can log in to the application.'
}

Table auth_refresh_tokens {
  id uuid [pk, note: 'Database default: gen_random_uuid()']
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique, note: 'SHA-256 hash; raw refresh tokens are never stored']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_auth_refresh_tokens_user']
  }

  Note: 'Refresh-token hashes used for rotation and logout. Added by Flyway V3.'
}

Table fraud_transactions {
  id uuid [pk, note: 'Database default: gen_random_uuid()']
  transaction_ref varchar(80) [not null, unique]
  from_account_ref varchar(80) [not null]
  from_account_masked varchar(40) [not null]
  from_customer_name varchar(120)
  to_account_ref varchar(80) [not null]
  to_account_masked varchar(40) [not null]
  to_customer_name varchar(120)
  amount numeric(19,4) [not null, note: 'CHECK amount > 0']
  currency char(3) [not null, default: 'VND']
  transaction_time timestamptz [not null]
  risk_score numeric(5,2) [not null, note: 'CHECK risk_score BETWEEN 0 AND 100']
  risk_level varchar(10) [not null, note: 'Allowed values: LOW, MEDIUM, HIGH, CRITICAL']
  fraud_reason varchar(500) [not null]
  review_status varchar(30) [not null, default: 'NEW', note: 'Allowed values: NEW, REVIEWING, CONFIRMED_FRAUD, FALSE_POSITIVE']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'idx_fraud_transactions_created', note: 'DESC']
    (risk_score, transaction_time) [name: 'idx_fraud_transactions_risk', note: 'Both columns DESC']
  }

  Note: 'Transactions already marked as suspicious or fraudulent.'
}

Table fraud_rule_hits {
  id uuid [pk, note: 'Database default: gen_random_uuid()']
  fraud_transaction_id uuid [not null]
  rule_code varchar(50) [not null]
  rule_name varchar(160) [not null]
  score_contribution numeric(5,2) [not null, note: 'CHECK score_contribution BETWEEN 0 AND 100']
  explanation varchar(500) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (fraud_transaction_id, rule_code) [unique, name: 'fraud_rule_hits_fraud_transaction_id_rule_code_key']
    fraud_transaction_id [name: 'idx_rule_hits_transaction']
  }

  Note: 'Rules that contributed to a fraud transaction risk score.'
}

Table transaction_chain {
  id uuid [pk, note: 'Database default: gen_random_uuid()']
  root_fraud_transaction_id uuid [not null]
  transaction_ref varchar(80) [not null]
  from_account_ref varchar(80) [not null]
  from_account_masked varchar(40) [not null]
  from_customer_name varchar(120)
  to_account_ref varchar(80) [not null]
  to_account_masked varchar(40) [not null]
  to_customer_name varchar(120)
  amount numeric(19,4) [not null, note: 'CHECK amount > 0']
  currency char(3) [not null, default: 'VND']
  transaction_time timestamptz [not null]
  hop_level integer [not null, note: 'CHECK hop_level >= 0']
  is_root boolean [not null, default: false, note: 'Root: true and hop_level = 0; following: false and hop_level > 0']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (root_fraud_transaction_id, transaction_ref) [unique, name: 'transaction_chain_root_fraud_transaction_id_transaction_ref_key']
    (root_fraud_transaction_id, hop_level, transaction_time) [name: 'idx_transaction_chain_root_hop']
  }

  Note: 'Directed money-flow edges discovered while tracing a root fraud transaction.'
}

Ref: fraud_rule_hits.fraud_transaction_id > fraud_transactions.id [delete: cascade]
Ref: transaction_chain.root_fraud_transaction_id > fraud_transactions.id [delete: cascade]
Ref: auth_refresh_tokens.user_id > users.id [delete: cascade]

