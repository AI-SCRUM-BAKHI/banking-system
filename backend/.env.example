SERVER_PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrum_ai
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_SWAGGER_ENABLED=true

# Base64-encoded 32-byte secret (e.g. generate with: openssl rand -base64 32)
APP_JWT_SECRET=
APP_JWT_ISSUER=scrum-ai
APP_SERVICE_TOKEN=

APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_FULL_NAME=

# Source transaction scanner (enable only after source and coverage are verified)
APP_FRAUD_SCAN_ENABLED=false
APP_FRAUD_RULE_VERSION=rule-score-v1
APP_FRAUD_SCAN_FIXED_DELAY_MS=30000
APP_FRAUD_SCAN_BATCH_SIZE=100
